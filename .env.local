# =========================
# Google reCAPTCHA v3
# =========================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# =========================
# SMTP Configuration
# =========================

# SMTP Server
SMTP_HOST=smtp.gmail.com

# SMTP Port
SMTP_PORT=465

# SMTP Security
SMTP_SECURE=true

# Gmail / Google Workspace Email
SMTP_USER=rsvp@sienaatl.com

# Gmail App Password (16-character App Password)
SMTP_PASS=YOUR_16_CHARACTER_APP_PASSWORD

# Email that will receive contact form submissions
SMTP_TO=rsvp@sienaatl.com
